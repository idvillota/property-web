# Local backend (Vite mode "development"). Used by: npm run dev
# Leave VITE_API_URL empty so Vite proxies /api to the API on your machine.
# VITE_API_URL=
#
# Or set a direct API URL:
# VITE_API_URL=http://localhost:5228
#
# To use a remote API from your machine, run: npm run start:dev
# (loads .env.dev — copy from .env.dev.example if missing)
